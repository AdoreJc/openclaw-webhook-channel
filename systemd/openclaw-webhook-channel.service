[Unit]
Description=OpenClaw Webhook Channel
After=network.target openclaw-gateway.service

[Service]
Type=simple
User=heixiu
WorkingDirectory=/mnt/e/repos/openclaw-webhook-channel
ExecStart=/mnt/e/repos/openclaw-webhook-channel/.venv/bin/python webhook_server.py -c config.json
Environment=PATH=/home/heixiu/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
